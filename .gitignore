# Local ClickHouse runtime artifacts generated when the server is started from
# this workspace. The production data and configuration live under ~/.local.
/access/
/preprocessed_configs/

# Collector runtime state, evidence caches, and local binaries.
/var/

# Local research outputs and datasets.
/research/

# Test-generated options evidence cache.
/internal/optionslive/var/

# Python bytecode generated by research scripts.
__pycache__/
*.py[cod]
