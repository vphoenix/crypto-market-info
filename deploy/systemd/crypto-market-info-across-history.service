[Unit]
Description=Across fixed 30-day history research backfill (2026-09-02 to 2026-10-02)
After=network-online.target crypto-market-info-clickhouse.service
Wants=network-online.target crypto-market-info-clickhouse.service

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-market-info
ExecStart=%h/crypto-market-info/var/across/bin/across-data history --database crypto_market_info_across_history --evidence var/across/history-evidence --range 8453:50783591:52079591 --range 42161:500994686:511000892
TimeoutStartSec=infinity
TimeoutStopSec=30
RemainAfterExit=yes
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=60
KillSignal=SIGTERM
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
