# OpenAPI definition

```json
{
  "openapi": "3.1.0",
  "info": {
    "title": "api-settings-public",
    "version": "2"
  },
  "servers": [
    {
      "url": "https://api-pub.bitfinex.com/v2"
    }
  ],
  "security": [
    {}
  ],
  "paths": {
    "/stats1/{key}:{size}:{sym_platform}:{side_pair}/{section}": {
      "get": {
        "summary": "Stats",
        "description": "The Stats endpoint provides various statistics on a specified trading pair or funding currency. Use the available keys to specify which statistic you wish to retrieve.",
        "operationId": "rest-public-stats",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Available keys: \"funding.size\", \"credits.size\", \"credits.size.sym\", \"pos.size\", \"vol.1d\", \"vol.7d\", \"vol.30d\", \"vwap\"",
            "required": true,
            "schema": {
              "type": "string",
              "default": "pos.size"
            }
          },
          {
            "name": "size",
            "in": "path",
            "description": "Available values: '1m' (for keys: \"pos.size\", \"funding.size\", \"credits.size\", \"credits.size.sym\"), \"30m\" (for keys: vol.1d, vol.7d, vol.30d), \"1d\" (for keys: vwap)",
            "required": true,
            "schema": {
              "type": "string",
              "default": "1m"
            }
          },
          {
            "name": "sym_platform",
            "in": "path",
            "description": "The symbol you want information about. (e.g. tBTCUSD, tETHUSD, fUSD, fBTC) (used for keys: \"pos.size\", \"funding.size\", \"credits.size\", \"credits.size.sym\", \"vwap\", \"vol1d/7d/30d\").",
            "required": true,
            "schema": {
              "type": "string",
              "default": "tBTCUSD"
            }
          },
          {
            "name": "side_pair",
            "in": "path",
            "description": "Used to specify the side for \"pos.size\" key. Available values: \"long\", \"short\". Only for non-funding queries. Used to specify the trading pair on credits.size.sym.",
            "schema": {
              "type": "string",
              "default": "long"
            },
            "required": true
          },
          {
            "name": "section",
            "in": "path",
            "description": "Available values: \"last\", \"hist\".",
            "required": true,
            "schema": {
              "type": "string",
              "default": "hist"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "+1: sort in ascending order | -1: sort in descending order (by MTS field).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "If start is given, only records with MTS >= start (milliseconds) will be given as response.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "If end is given, only records with MTS <= end (milliseconds) will be given as response.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of records in response (max. 10000).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "// Response with section=\"last\"\n[ \n  1573554000000, //MTS\n  25957.94278561 //VALUE\n]\n\n// Response with section=\"hist\"\n[\n  [\n   \t1573560420000, //MTS\n   \t369005353.5945115 //VALUE\n  ],\n  [...]\n]"
                  }
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": []
      }
    }
  },
  "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "x-readme-fauxas": true
}
