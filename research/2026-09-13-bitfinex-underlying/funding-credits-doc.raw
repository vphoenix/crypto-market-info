      <td>Period of the loan</td>
    </tr>
    <tr>
      <td>[13]</td>
      <td>MTS_OPENING</td>
      <td>Int</td>
      <td>Millisecond Time Stamp for when the loan was opened</td>
    </tr>
    <tr>
      <td>[14]</td>
      <td>MTS_LAST_PAYOUT</td>
      <td>Int</td>
      <td>Millisecond Time Stamp for when the last payout was made</td>
    </tr>
    <tr>
      <td>[15]</td>
      <td>NOTIFY</td>
      <td>Int</td>
      <td>0 if false, 1 if true</td>
