    <tr>
      <td>[2]</td>
      <td>SIDE</td>
      <td>Int</td>
      <td>1 if you are the lender, 0 if you are both the lender and borrower, -1 if you're the borrower</td>
    </tr>
    <tr>
      <td>[3]</td>
      <td>MTS_CREATE</td>
      <td>Int</td>
      <td>Millisecond Time Stamp when the loan was created</td>
