	<h1 class="single-post__title">How to Trade Margin on Bitfinex</h1>
	<time class="single-post__date" datetime="2026-07-17T11:18:47+00:00">
		17 July, 2026	</time>

	
<div class="share-dropdown share-dropdown--mobile">
	<button class="btn" id="share-button-mobile" aria-label="Share" aria-expanded="false">
